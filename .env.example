# Public site URL (used for metadata, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: real contact-form delivery via Resend (https://resend.com) ---
# If these are NOT set, the contact form falls back to a mailto: link and
# never claims that a message was sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender verified in your Resend account, e.g. "Portfolio <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=
